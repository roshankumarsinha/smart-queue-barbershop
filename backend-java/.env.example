# Reference for the available settings. Every value below is already the default in
# application.yml, so `docker compose up -d && ./mvnw spring-boot:run` works untouched.
#
# NOTE: Spring Boot does NOT read .env files (unlike the NestJS backend). To use this,
# export it into your shell first:
#
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# or pass values inline:  DATABASE_URL=... ./mvnw spring-boot:run

DATABASE_URL="jdbc:postgresql://localhost:5432/smartqueue"
DATABASE_USER="smartqueue"
DATABASE_PASSWORD="smartqueue"

# HS256 requires at least 32 bytes. Change this everywhere except local dev.
JWT_SECRET="dev-secret-change-me-at-least-32-bytes-long"
JWT_EXPIRES_IN="7d"

PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost,http://localhost"

# Leave blank to keep notifications in free "log only" stub mode.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Demo shop + logins. Set to false in production.
SEED_DEMO_DATA=true
