// Smart Queue — Prisma schema
//
// Provider is SQLite (free, file-based, zero setup). To move to a free hosted
// Postgres (Neon / Supabase) later: change provider to "postgresql", point
// DATABASE_URL at the connection string, then `npm run prisma:migrate`.
//
// Enum-like columns (role, status, service) are stored as String with the
// allowed values documented inline — this keeps the schema portable across
// SQLite and Postgres. See src/common/constants.ts for the source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id   String @id @default(cuid())
  name String

  // The SHOP_OWNER user that owns this shop. One owner can hold many shops.
  ownerId String?
  owner   User?   @relation("ShopOwner", fields: [ownerId], references: [id])

  // The kind of venue (SALON | RESTAURANT | HOSPITAL | CLINIC | GOVERNMENT | RETAIL | OTHER).
  type String @default("SALON")

  // A shop's WhatsApp number is how customers reach it, so two shops must never
  // share one. NULL is exempt (a shop can be onboarded before its number is known),
  // and SQLite allows many NULLs under a unique constraint.
  whatsappNumber String? @unique
  phone          String? // the shop's own contact line, distinct from whatsappNumber
  address        String?
  locationUrl    String? // a Google Maps share link, opened on click (no Maps API)

  openingTime String? // "HH:mm", nullable — hours may be unknown at onboarding
  closingTime String?

  // Lifecycle: NEW (just registered) | OPEN (taking customers) | CLOSED. See ShopStatus.
  status String @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]       @relation("ShopStaff")
  queueEntries QueueEntry[]
}

model User {
  id   String @id @default(cuid())
  role String // SHOP_OWNER | BARBER_STAFF | SUPER_ADMIN | CUSTOMER
  name String

  // Owners & admins sign in with email + password.
  email        String? @unique
  passwordHash String?

  // Barbers sign in with phone + PIN.
  phone   String? @unique
  pinHash String?

  // A staff member's shop (barbers, and the owner's default "active shop").
  shopId String?
  shop   Shop?   @relation("ShopStaff", fields: [shopId], references: [id])

  // Shops this user owns (SHOP_OWNER). Distinct from `shop` above.
  ownedShops Shop[] @relation("ShopOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QueueEntry {
  id           String  @id @default(cuid())
  shopId       String
  shop         Shop    @relation(fields: [shopId], references: [id])
  token        Int // human-facing token number, unique per shop
  customerName String?
  phone        String?
  service      String // HAIRCUT | BEARD | HAIRCUT_BEARD
  status       String  @default("WAITING") // WAITING | IN_SERVICE | DONE | SKIPPED | NO_SHOW | LEFT
  position     Int // ordering within the waiting list

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([shopId, status])
}

model Notification {
  id           String     @id @default(cuid())
  queueEntryId String
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id])
  type         String // e.g. JOINED | ALMOST_YOUR_TURN | YOUR_TURN | REMOVED
  channel      String     @default("whatsapp")
  sentAt       DateTime   @default(now())
}
